# TESTOPO - variables de entorno (SPEC 018.2). Copia este archivo a `.env`
# (o `.env.local`) y rellena con los valores de TU proyecto Supabase.
# NUNCA subas el .env real ni pongas claves reales aqui.

# --- Frontend (PUBLICAS, pueden ir en el bundle: prefijo VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Solo servidor (NUNCA en el frontend, NUNCA con prefijo VITE_) ---
# La service_role tiene permisos totales: usar solo en servidor/edge functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres
