# TESTOPO - variables de entorno (SPEC 018.2). Copia este archivo a `.env`
# (o `.env.local`) y rellena con los valores de TU proyecto Supabase.
# NUNCA subas el .env real ni pongas claves reales aqui.

# --- Frontend (PUBLICAS, pueden ir en el bundle: prefijo VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Solo servidor (NUNCA en el frontend, NUNCA con prefijo VITE_) ---
# La service_role tiene permisos totales: usar solo en servidor/edge functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Modo de persistencia del bloque cuenta/espacios (SPEC 020) ---
# Controla SOLO profiles/workspaces/workspace_members; el resto del dominio
# (oposiciones, materiales, preguntas, tests) sigue SIEMPRE en memoria (estado
# hibrido). Valores: `memory` (defecto, demo en memoria) o `supabase`.
# `supabase` solo surte efecto si ademas Supabase esta configurado (URL+anon);
# si no, cae a `memory` automaticamente (fallback seguro para CI/tests).
APP_PERSISTENCE_MODE=memory
# Variante publica que lee el frontend (prefijo VITE_, sin secretos). Usa la
# clave anonima via VITE_SUPABASE_ANON_KEY; la service_role NUNCA llega al front.
VITE_APP_PERSISTENCE_MODE=memory

# --- Generacion de preguntas con IA (SPEC 018.4 / 018.4-B, solo servidor) ---
# Proveedor principal recomendado: OpenAI. Alternativo: Anthropic. Tests/local: mock.
# AI_PROVIDER=mock NO llama a ninguna API externa (valor seguro para CI/tests).
AI_PROVIDER=openai
# OpenAI (proveedor principal). Si AI_PROVIDER=openai y falta OPENAI_API_KEY -> error claro.
OPENAI_API_KEY=your-openai-api-key-server-only
# Modelo configurable (no se fija en codigo). Debe soportar salida estructurada
# (json_schema strict): p.ej. gpt-4o-mini, gpt-4o. Consulta la doc oficial de OpenAI.
OPENAI_MODEL=gpt-4o-mini
# Anthropic (proveedor alternativo, opcional). Solo se usa con AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key-server-only
ANTHROPIC_MODEL=claude-opus-4-8
# Limites de coste/seguridad de la generacion.
MAX_GENERATION_INPUT_CHARS=20000
MAX_GENERATED_QUESTIONS=20
# Indice de temario con IA (SPEC 019). Usa el mismo proveedor (AI_PROVIDER/OPENAI_*).
MAX_SYLLABUS_INDEX_INPUT_CHARS=50000
MAX_SYLLABUS_TOPICS=100

# --- IA local / OpenAI-compatible (SPEC 041, SOLO servidor) ---
# Permite apuntar la generacion (generate-questions-from-studied-material) y el
# estudio (study-material) a un servidor OpenAI-compatible (LM Studio local hoy,
# servidor europeo con GPU manana) SIN tocar codigo. Las variables AI_* tienen
# PRIORIDAD; si no estan, se usa el esquema OPENAI_*/STUDY_* actual (riesgo cero).
# Valores de AI_PROVIDER: openai | lmstudio | custom-openai-compatible | disabled.
#
# Ejemplo LM Studio (descomenta para usar IA local):
# AI_PROVIDER=lmstudio
# AI_BASE_URL=http://192.168.1.50:1234/v1   # IP del PC de IA (LAN o tunel publico)
# AI_API_KEY=lm-studio                       # LM Studio acepta una key dummy
# AI_MODEL=qwen3-8b-instruct                 # nombre del modelo cargado en LM Studio
# AI_REQUEST_TIMEOUT_MS=120000               # la IA local puede ser mas lenta
# AI_CONTEXT_WINDOW_TOKENS=8192              # ventana del modelo local (informativo)
# AI_MAX_SOURCE_CHARS=8000                   # tope de fuente; solo ENDURECE los MAX_* del flujo
# AI_ENABLE_THINKING=false                   # Qwen3: por defecto el thinking se desactiva en local
#
# Base URL del proveedor actual (opcional; default https://api.openai.com/v1).
# Si AI_BASE_URL no esta, se usa OPENAI_BASE_URL y, si tampoco, el default OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OCR de PDFs escaneados en servidor (SPEC 034, SOLO servidor) ---
# Secretos de la Edge Function `ocr-material`. NUNCA con prefijo VITE_, nunca en el
# repo. Sin OCR_PROVIDER compatible + OPENAI_API_KEY, la funcion responde 501
# OCR_PROVIDER_NOT_CONFIGURED y NO persiste nada (conserva `scanned_detected`).
# Proveedores admitidos: openai | anthropic. El modelo debe soportar VISION.
OCR_PROVIDER=openai
OCR_MODEL=gpt-4o-mini
# Reutiliza OPENAI_API_KEY (definida arriba) como clave del proveedor de vision.
